<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Login</title><link rel="stylesheet" href="/style.css"></head><body><main>
<h1>Patient Login</h1>
<% if (error) { %><p style="color:red"><%= error %></p><% } %>
<form method="post" action="/login">
  <input name="email" type="email" placeholder="Email" required>
  <input name="password" type="password" placeholder="Password" required>
  <input name="mfaCode" placeholder="MFA code" required>
  <button>Log in</button>
</form>
</main></body></html>
